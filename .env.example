# Backend API URL (used by Next.js server rewrites to proxy /api/* and /uploads/*)
BACKEND_URL=http://localhost:5000

# Optional public API base URL (leave as /api to use Next.js rewrites, or set full backend URL in production)
NEXT_PUBLIC_API_URL=/api

# Optional public customer website URL for "Live Site" / "Open Public Website" links
NEXT_PUBLIC_SITE_URL=http://localhost:5173
